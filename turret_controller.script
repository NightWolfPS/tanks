
-- turret_controller.script
-- Управление башней, стрельба и HUD перезарядки

go.property("turret_turn_speed", 120)
go.property("fire_cooldown", 0.5)
go.property("muzzle_distance", 50)

local turret_left = false
local turret_right = false
local fire_pressed = false

local turret_angle = 0
local fire_timer = 0

local function send_reload_progress(self)
	local progress = 1

	if self.fire_cooldown > 0 then
		progress = 1 - fire_timer / self.fire_cooldown
	end

	progress = math.max(0, math.min(1, progress))

	msg.post("main:/tank_hud#gui", "reload_progress", {
		progress = progress
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")

	local _, _, angle = vmath.quat_to_euler(
	go.get_rotation()
)

turret_angle = angle

send_reload_progress(self)
end

function on_input(self, action_id, action)
if action_id == hash("z") then
	if action.pressed then
		turret_left = true
	elseif action.released then
		turret_left = false
	end

	return true

elseif action_id == hash("x") then
	if action.pressed then
		turret_right = true
	elseif action.released then
		turret_right = false
	end

	return true

elseif action_id == hash("space") then
	if action.pressed then
		fire_pressed = true
	elseif action.released then
		fire_pressed = false
	end

	return true
end

return false
end

local function fire(self)
local rotation = go.get_world_rotation()
local position = go.get_world_position()

local direction = vmath.rotate(
rotation,
vmath.vector3(0, 1, 0)
)

local spawn_position = position
+ direction * self.muzzle_distance

print("[TURRET] Fire requested")

-- Вспышка у дула
local ok_flash, flash_id = pcall(function()
return factory.create(
"#muzzle_flash_factory",
spawn_position,
rotation
)
end)

if ok_flash and flash_id then
msg.post(flash_id, "play_effect")
else
print("[TURRET] MUZZLE FACTORY ERROR: "
.. tostring(flash_id))
end

-- Снаряд
-- Снаряд игрока.
local owner_id = go.get_parent() or go.get_id()

local ok_projectile, projectile_id = pcall(function()
	return factory.create(
	"#projectile_factory",
	spawn_position,
	rotation,
	{
		damage = 25,
		owner_group = hash("tank"),
		owner_id = owner_id
	}
)
end)

if not ok_projectile or not projectile_id then
print(
"[TURRET] PROJECTILE FACTORY ERROR: "
.. tostring(projectile_id)
)
end
end

function update(self, dt)
-- Поворот башни
if turret_left then
turret_angle = turret_angle
+ math.rad(self.turret_turn_speed) * dt
end

if turret_right then
turret_angle = turret_angle
- math.rad(self.turret_turn_speed) * dt
end

go.set_rotation(
vmath.quat_rotation_z(turret_angle)
)

-- Перезарядка идёт независимо от состояния кнопки.
if fire_timer > 0 then
fire_timer = math.max(0, fire_timer - dt)
end

-- Выстрел только при завершённой перезарядке.
if fire_pressed and fire_timer <= 0 then
fire(self)
fire_timer = self.fire_cooldown
end

-- Передаём актуальный прогресс шкале каждый кадр.
send_reload_progress(self)
end
