-- tank_controller.script
-- Управление танком игрока и система здоровья.

go.property("move_speed", 180)
go.property("turn_speed", 120)
go.property("max_hp", 100)

local TANK_SPAWNER_URL =
msg.url("main:/tank_spawner#tank_spawner")

local BOT_SPAWNER_URL =
msg.url("main:/bot_spawner#bot_spawner")

-- ВАЖНО: путь и ID должны соответствовать GUI-компоненту
-- HUD в main.collection.
local HUD_URL = msg.url("main:/tank_hud#gui")


local move_forward = false
local move_backward = false
local turn_left = false
local turn_right = false

local hull_angle = 0


-- =========================================================
-- HUD
-- =========================================================

local function update_health_hud(self)
	print(
	"[PLAYER] Sending health to HUD: "
	.. tostring(self.hp)
	.. "/"
	.. tostring(self.max_hp)
)

msg.post("/tank_hud#gui", "health_update", {
	health = self.hp,
	max_health = self.max_hp
})
end


-- =========================================================
-- Смерть игрока
-- =========================================================

local function kill_player(self, killer_id)
	if self.dead then
		return
	end

	self.dead = true

	move_forward = false
	move_backward = false
	turn_left = false
	turn_right = false

	print("[PLAYER] Destroyed")

	update_health_hud(self)

	-- Сообщаем системе статистики о смерти и убийце.
	msg.post(BOT_SPAWNER_URL, "player_died", {
		player_id = go.get_id(),
		killer_id = killer_id
	})

	-- Отдельно запускаем обычный респавн танка.
	msg.post(TANK_SPAWNER_URL, "player_destroyed")
end


-- =========================================================
-- Инициализация
-- =========================================================

function init(self)
	self.hp = self.max_hp
	self.dead = false

	self.correction = vmath.vector3(0, 0, 0)

	move_forward = false
	move_backward = false
	turn_left = false
	turn_right = false

	local _, _, angle = vmath.quat_to_euler(
	go.get_rotation()
)

hull_angle = angle

-- Регистрируем игрока для ИИ ботов.
msg.post(BOT_SPAWNER_URL, "register_player", {
	player_id = go.get_id()
})

msg.post(".", "acquire_input_focus")

update_health_hud(self)

print(
"[PLAYER] Initialized. HP: "
.. self.hp .. "/" .. self.max_hp
)
end


-- =========================================================
-- Управление
-- =========================================================

function on_input(self, action_id, action)
if self.dead then
return true
end

if action_id == hash("up") then
if action.pressed then
	move_forward = true
elseif action.released then
	move_forward = false
end

return true

elseif action_id == hash("down") then
if action.pressed then
	move_backward = true
elseif action.released then
	move_backward = false
end

return true

elseif action_id == hash("left") then
if action.pressed then
	turn_left = true
elseif action.released then
	turn_left = false
end

return true

elseif action_id == hash("right") then
if action.pressed then
	turn_right = true
elseif action.released then
	turn_right = false
end

return true
end

return false
end


-- =========================================================
-- Обновление движения
-- =========================================================

function update(self, dt)
if self.dead then
return
end

self.correction = vmath.vector3(0, 0, 0)

if turn_left then
hull_angle = hull_angle
+ math.rad(self.turn_speed) * dt
end

if turn_right then
hull_angle = hull_angle
- math.rad(self.turn_speed) * dt
end

go.set_rotation(
vmath.quat_rotation_z(hull_angle)
)

local rotation = vmath.quat_rotation_z(hull_angle)

local direction = vmath.rotate(
rotation,
vmath.vector3(0, 1, 0)
)

local movement = vmath.vector3(0, 0, 0)

if move_forward then
movement = movement
+ direction * self.move_speed * dt
end

if move_backward then
movement = movement
- direction * self.move_speed * dt
end

local position = go.get_position()

go.set_position(position + movement)
end


-- =========================================================
-- Сообщения: урон, здоровье и физические контакты
-- =========================================================

function on_message(self, message_id, message, sender)
if self.dead then
return
end

-- Получение урона от вражеского снаряда.
if message_id == hash("take_damage") then
local damage = tonumber(message.damage) or 0

if damage <= 0 then
return
end

self.hp = math.max(
0,
self.hp - damage
)

print("[PLAYER] Took " .. damage .. " damage")

print(
"[PLAYER] HP: "
.. self.hp .. "/" .. self.max_hp
)

update_health_hud(self)

if self.hp <= 0 then
	kill_player(self, message.killer_id)
end

-- Запрос текущего здоровья.
elseif message_id == hash("get_hp") then
msg.post(sender, "hp_response", {
hp = self.hp,
max_hp = self.max_hp,
dead = self.dead
})

-- Сохранена обработка контактов с препятствиями.
elseif message_id == hash("contact_point_response") then
if message.distance > 0 then
local penetration =
message.normal * message.distance

local projection = vmath.project(
self.correction,
penetration
)

if projection < 1 then
local compensation =
penetration * (1 - projection)

go.set_position(
go.get_position() + compensation
)

self.correction =
self.correction + compensation
end
end
end
end